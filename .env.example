NODE_ENV=production
PORT=3000
HOST=0.0.0.0
SQLITE_PATH=file:/app/server/data/kanban.db
# Generate a real 64-character hex value with: openssl rand -hex 32
APP_SECRET=REPLACE_WITH_64_HEX_CHARS_GENERATED_BY_OPENSSL_RAND_HEX_32
# Must match the Docker bridge subnet the container is attached to (see docker-compose.yml).
# In this compose file that subnet is 172.28.0.0/16; it is NOT 127.0.0.1/32 because the
# socket peer inside the container is the Docker gateway, not the host loopback.
TRUSTED_PROXY_CIDR=172.28.0.0/16
JWT_EXPIRY=7d
# Legacy v1 owner token. Only used on migrated instances during the claim window.
# On first boot of a fresh instance, use the setup token printed in the container log.
OWNER_TOKEN=your-owner-token-for-human-login
# Optional agent API keys, imported once at first boot. Format: role:Name:bzk_<prefix>_<secret>
AGENT_API_KEYS=owner:OpenClaw:bzk_rz75ihlkajnp_rwwwl7d7qohupxceerkzt2gbkehtyhch,editor:Hexagon:bzk_gxhofcbufujw_2gvohuca23qmumlgzqxqwoyk6zh6ooxn
BUZZ_RELAY_URL=wss://buzz.10ktechnology.com
BUZZ_SERVICE_PUBKEY=
BUZZ_VERIFY_SIGNATURES=true
