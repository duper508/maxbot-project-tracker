<% content_for :title, "Settings" %>
<% content_for :breadcrumb_standalone, "Settings" %>

<div class="space-y-6 mt-12">
  <!-- Section 1: Profile -->
  <div class="bg-bg-surface border border-border rounded-lg p-5 space-y-4">
    <h3 class="text-xs font-medium text-content-muted uppercase tracking-wider font-display">Profile</h3>

    <%= form_with(model: @user, url: settings_path, method: :patch, class: "space-y-4") do |form| %>
      <!-- Avatar -->
      <div>
        <label class="block text-xs font-medium text-content-secondary mb-2">Avatar</label>
        <div class="flex items-center gap-4">
          <% if @user.has_avatar? %>
            <%= image_tag @user.avatar_source, class: "w-14 h-14 object-cover rounded-full" %>
          <% else %>
            <div class="w-14 h-14 rounded-full bg-bg-elevated flex items-center justify-center">
              <svg class="w-7 h-7 text-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
          <% end %>
          <div class="flex-1">
            <%= form.file_field :avatar, accept: "image/jpeg,image/jpg,image/png,image/webp", class: "block w-full text-xs text-content-secondary file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-medium file:bg-bg-elevated file:text-content-secondary hover:file:bg-bg-hover file:cursor-pointer file:transition-colors" %>
            <p class="text-xs text-content-muted mt-1">Max 512KB, 256x256px. JPEG, PNG, or WebP.</p>
          </div>
        </div>
        <% if @user.avatar.attached? || @user.avatar_url.present? %>
          <div class="mt-3">
            <label class="flex items-center text-xs text-content-secondary cursor-pointer">
              <%= form.check_box :remove_avatar, class: "mr-2 rounded border-border bg-bg-elevated text-accent focus:ring-accent focus:ring-offset-bg-surface" %>
              Remove avatar
            </label>
          </div>
        <% end %>
        <% if @user.errors[:avatar].any? %>
          <div class="mt-2">
            <% @user.errors[:avatar].each do |error| %>
              <p class="text-status-error text-xs">Avatar <%= error %></p>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Email -->
      <div class="pt-4 border-t border-border">
        <label class="block text-xs font-medium text-content-secondary mb-1.5">Email Address</label>
        <%= form.email_field :email_address, placeholder: "your@email.com", class: "block w-full bg-bg-elevated border-0 rounded-md px-3 py-2 text-sm text-content placeholder:text-content-muted focus:ring-1 focus:ring-accent focus:outline-none" %>
        <% if @user.errors[:email_address].any? %>
          <div class="mt-1">
            <% @user.errors[:email_address].each do |error| %>
              <p class="text-status-error text-xs">Email <%= error %></p>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="pt-2">
        <%= form.submit "Save profile", class: "cursor-pointer px-4 py-2 bg-accent text-content hover:bg-accent-hover text-xs font-semibold rounded-md transition-colors duration-200" %>
      </div>
    <% end %>
  </div>

  <!-- Section 2: Agents -->
  <div class="bg-bg-surface border border-border rounded-lg p-5 space-y-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-lg">🦞</span>
        <h3 class="text-sm font-semibold text-content font-display">Agents</h3>
      </div>
    </div>

    <p class="text-xs text-content-secondary">
      Connect AI agents to ClawDeck. Each agent gets its own API token and prompt. Add a new agent, then copy its prompt into your agent's configuration.
    </p>

    <% if @agents.any? %>
      <div class="space-y-3">
        <% @agents.each do |agent| %>
          <div class="border border-border rounded-lg p-4 space-y-3" data-controller="toggle">
            <!-- Agent Header -->
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <%= agent_icon(agent, size_class: "w-8 h-8") %>
                <div>
                  <span class="text-sm font-medium text-content"><%= agent.name %></span>
                  <% status = agent.status %>
                  <span class="ml-2 inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium
                    <%= case status
                        when 'active' then 'bg-green-500/20 text-green-400'
                        when 'working' then 'bg-accent/20 text-accent'
                        when 'idle' then 'bg-yellow-500/20 text-yellow-400'
                        else 'bg-bg-elevated text-content-muted'
                        end %>">
                    <%= status.titleize %>
                  </span>
                </div>
              </div>
              <div class="flex items-center gap-1">
                <% if agent.last_active_at.present? %>
                  <span class="text-[10px] text-content-muted mr-2">Last active: <%= time_ago_in_words(agent.last_active_at) %> ago</span>
                <% end %>
              </div>
            </div>

            <!-- Agent Actions -->
            <div class="flex flex-wrap items-center gap-2">
              <button type="button"
                      data-action="click->toggle#toggle"
                      data-toggle-target="button"
                      class="cursor-pointer px-2.5 py-1.5 bg-bg-elevated hover:bg-bg-hover text-content-secondary text-xs font-medium rounded-md transition-colors">
                Show Prompt
              </button>

              <details class="group relative">
                <summary class="cursor-pointer px-2.5 py-1.5 bg-bg-elevated hover:bg-bg-hover text-content-secondary text-xs font-medium rounded-md transition-colors list-none">
                  Change Icon
                </summary>
                <div class="absolute right-0 top-full mt-2 z-10 p-3 min-w-[200px] border border-border rounded-lg bg-bg-elevated shadow-xl">
                  <%= form_with model: agent, url: agent_path(agent), method: :patch, class: "flex flex-col gap-3" do |f| %>
                    <div class="flex flex-wrap gap-2 justify-center">
                      <% [
                        { key: "gemini", icon: "gemini.svg" },
                        { key: "codex", icon: "codex.svg" },
                        { key: "claude", icon: "claude.svg" },
                        { key: "lobster", icon: "lobster.svg" },
                        { key: "robot", icon: "robot.svg" }
                      ].each do |option| %>
                        <label class="cursor-pointer">
                          <%= f.radio_button :emoji, option[:key], class: "peer sr-only" %>
                          <div class="p-1.5 rounded-md border border-border bg-bg-surface peer-checked:border-accent peer-checked:bg-accent/10 peer-checked:ring-1 peer-checked:ring-accent hover:bg-bg-hover transition-all" title="<%= option[:key].titleize %>">
                            <%= image_tag "agents/#{option[:icon]}", class: "w-6 h-6" %>
                          </div>
                        </label>
                      <% end %>
                    </div>
                    <%= f.submit "Update Icon", class: "w-full cursor-pointer px-2 py-1.5 bg-accent text-content hover:bg-accent-hover text-xs font-semibold rounded transition-colors" %>
                  <% end %>
                </div>
              </details>

              <%= button_to regenerate_token_agent_path(agent),
                  method: :post,
                  data: { turbo_confirm: "This will invalidate the current token for \"#{agent.name}\". Continue?" },
                  class: "cursor-pointer px-2.5 py-1.5 bg-bg-elevated hover:bg-bg-hover text-content-secondary text-xs font-medium rounded-md transition-colors" do %>
                Regenerate Token
              <% end %>

              <%= button_to agent_path(agent),
                  method: :delete,
                  data: { turbo_confirm: "Remove agent \"#{agent.name}\"? This will revoke its API token and unassign its tasks." },
                  class: "cursor-pointer px-2.5 py-1.5 bg-bg-elevated hover:bg-red-500/20 text-content-muted hover:text-red-400 text-xs font-medium rounded-md transition-colors" do %>
                Remove
              <% end %>
            </div>

            <!-- Expandable Prompt Section -->
            <div data-toggle-target="content" class="hidden">
              <%= render "agents/prompt", agent: agent %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-6">
        <p class="text-sm text-content-muted">No agents yet. Add one to get started.</p>
      </div>
    <% end %>

    <!-- Add Agent Form -->
    <div class="pt-3 border-t border-border">
      <%= form_with model: Agent.new, url: agents_path, class: "flex flex-col gap-4" do |form| %>
        <div class="flex items-start gap-3">
          <div class="flex-1">
            <label class="block text-xs font-medium text-content-secondary mb-1">Name</label>
            <%= form.text_field :name, placeholder: "e.g. OpenClaw", required: true, class: "block w-full bg-bg-elevated border-0 rounded-md px-3 py-2 text-sm text-content placeholder:text-content-muted focus:ring-1 focus:ring-accent focus:outline-none" %>
          </div>
          
          <div class="flex-1">
            <label class="block text-xs font-medium text-content-secondary mb-1">Icon</label>
            <div class="flex flex-wrap gap-2">
              <% [
                { key: "gemini", icon: "gemini.svg", label: "Gemini" },
                { key: "codex", icon: "codex.svg", label: "Codex" },
                { key: "claude", icon: "claude.svg", label: "Claude" },
                { key: "lobster", icon: "lobster.svg", label: "Lobster" },
                { key: "robot", icon: "robot.svg", label: "Robot" }
              ].each do |option| %>
                <label class="cursor-pointer group relative">
                  <%= form.radio_button :emoji, option[:key], checked: option[:key] == "lobster", class: "peer sr-only" %>
                  <div class="p-1.5 rounded-md border border-border bg-bg-elevated peer-checked:border-accent peer-checked:bg-accent/10 peer-checked:ring-1 peer-checked:ring-accent hover:bg-bg-hover transition-all" title="<%= option[:label] %>">
                    <%= image_tag "agents/#{option[:icon]}", class: "w-6 h-6" %>
                  </div>
                </label>
              <% end %>
            </div>
          </div>
        </div>

        <div class="flex justify-end">
          <%= form.submit "Add Agent", class: "cursor-pointer px-4 py-2 bg-accent text-content hover:bg-accent-hover text-xs font-semibold rounded-md transition-colors duration-200 whitespace-nowrap" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
